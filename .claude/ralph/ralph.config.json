{
    "defaultProfile": "playground",
    "common": {
        "active": true,
        "maxIterations": 10,
        "maxTurns": 200,
        "claudeTimeoutMs": 7200000,
        "authorAllowlist": ["Pelmenya"],
        "model": "claude-opus-4-8",
        "fallbackModel": "claude-opus-4-8",
        "permissionMode": "bypassPermissions",
        "installCmd": "npm ci",
        "issueLabels": [
            "complexity:low",
            "complexity:medium",
            "complexity:high",
            "complexity:expert",
            "area:backend",
            "area:core",
            "area:frontend",
            "area:devops",
            "area:docs",
            "backlog"
        ],
        "board": {
            "owner": "AtlantaTeam",
            "number": 1
        },
        "gate": {
            "checks": [
                ["security:canary", "npm run security:canary"],
                ["docs:agents-drift", "npm run docs:agents-drift"],
                ["test:ratchet", "npm run test:ratchet"],
                ["test:only-detect", "npm run test:only-detect"],
                ["test:skip-detect", "npm run test:skip-detect"],
                ["build", "npm run build"],
                ["lint", "npm run lint"],
                ["lint:fsd", "npm run lint:fsd"],
                ["typecheck", "npm run typecheck"],
                ["typecheck:ralph", "npm run typecheck:ralph"],
                ["test", "npm run test --silent"]
            ],
            "prodChecks": [
                ["security", "npm run security:audit"],
                ["coverage", "npm run test:coverage"],
                ["e2e", "CI=1 npm run test:e2e"]
            ],
            "prodDropChecks": ["test"]
        },
        "blockedHealAttempts": 3,
        "gateHealAttempts": 2,
        "apiLimitMaxWaits": 3,
        "apiLimitGraceMin": 5,
        "deployCheck": {
            "workflow": "deploy.yml",
            "timeoutMs": 1200000,
            "pollIntervalMs": 15000,
            "healthUrl": "https://pixeltanks.ru",
            "healthTimeoutMs": 10000,
            "healthRetries": 3,
            "healthRetryDelayMs": 5000
        },
        "deadman": {
            "iterationGraceMs": 600000,
            "gateSilenceMs": 600000,
            "defaultSilenceMs": 300000
        },
        "modelRouting": {
            "default": "claude-opus-4-8",
            "labels": {
                "complexity:low": "claude-haiku-4-5-20251001",
                "complexity:medium": "claude-sonnet-5",
                "complexity:high": "claude-opus-4-8",
                "complexity:expert": "claude-fable-5"
            }
        },
        "review": {
            "default": "claude-opus-4-8",
            "escalated": "claude-opus-4-8",
            "fallback": "claude-opus-4-8",
            "escalateOn": [],
            "escalateOnPaths": [
                ".github/workflows/**",
                ".claude/ralph/**",
                "deploy/**",
                "scripts/**"
            ],
            "maxTurns": 80,
            "diffLimit": 60000
        },
        "tunnelCheck": {
            "enabled": false,
            "proxyUrl": "http://127.0.0.1:8118",
            "ipCheckUrl": "https://api.ipify.org",
            "restartCmd": "systemctl restart shadowsocks-libev-local@frankfurt privoxy",
            "restartWaitMs": 3000
        },
        "prompt": "Прочитай .claude/ralph/ralph.md и строго следуй правилам оттуда. Возьми следующий открытый Issue из milestone '{milestone}' и реализуй его в ветке '{branch}'.",
        "phases": [
            {
                "milestone": "Экран боя ralph · Фаза 1: HP-модель боя",
                "branch": "feature/game-screen-1-hp-model"
            },
            {
                "milestone": "Экран боя ralph · Фаза 2: Оверлейный HUD",
                "branch": "feature/game-screen-2-hud"
            },
            {
                "milestone": "Экран боя ralph · Фаза 3: Визуал жеста и состояния",
                "branch": "feature/game-screen-3-gesture"
            },
            {
                "milestone": "Экран боя ralph · Фаза 4: Витрина и визрегрессия",
                "branch": "feature/game-screen-4-showcase"
            },
            {
                "milestone": "Мобильная эргономика боя · Фаза 1: HUD не скачет",
                "branch": "feature/mobile-ergo-1-stable-hud"
            },
            {
                "milestone": "Мобильная эргономика боя · Фаза 2: Компактные оверлеи",
                "branch": "feature/mobile-ergo-2-compact"
            },
            {
                "milestone": "Мобильная эргономика боя · Фаза 3: Safe-зона арены и масштаб мира",
                "branch": "feature/mobile-ergo-3-arena"
            }
        ]
    },
    "profiles": {
        "playground": {},
        "prod": {
            "haltBeforeDeploy": false
        }
    }
}
