{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true
    },
    "include": ["**/*.ts"]
}
